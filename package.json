{
  "name": "tiktakto",
  "version": "1.0.0",
  "description": "Caro / Tic-tac-toe bàn cờ vô hạn, chơi online qua link",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/app.css -o public/shared/app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/app.css -o public/shared/app.css --watch"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "daisyui": "^4.12.24",
    "tailwindcss": "^3.4.19"
  }
}
